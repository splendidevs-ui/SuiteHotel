# --- Base de donnees ---
# SQLite en developpement. Pour la production, basculer le provider Prisma
# sur postgresql et renseigner l'URL de connexion ici.
DATABASE_URL="file:./dev.db"

# --- Fuseau horaire de l'hotel ---
# Sert a dater "aujourd'hui" (arrivees, departs, numerotation annuelle) et a
# afficher l'heure des encaissements.
NEXT_PUBLIC_TIME_ZONE="Africa/Abidjan"
