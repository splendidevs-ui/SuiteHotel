{
  "name": "suitehotel",
  "version": "1.0.0",
  "private": true,
  "description": "SuiteHotel - Gestion d'hôtel de luxe : réservations multi-chambres, devis, reçus et restauration en option.",
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "prisma generate && next build",
    "start": "next start -p 3300",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "test:smoke": "node scripts/run-smoke.mjs",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "db:studio": "prisma studio",
    "setup": "prisma db push && npm run db:seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "next": "16.3.5",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2"
  }
}
